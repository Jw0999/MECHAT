# MeChat Environment Variables
# Replace with your Supabase Project URL and Anon/Public Key from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: STUN / TURN servers for WebRTC calls
# Public Google STUN servers are used by default (stun:stun.l.google.com:19302)
# If using Metered or Twilio TURN, provide them below:
# VITE_TURN_URLS=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
